# ------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and fill in the value.
# `.env` is git-ignored so the real access key is never committed.
# ------------------------------------------------------------------

# Web3Forms access key used by the contact form (https://web3forms.com)
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
VITE_WEB3FORMS_KEY=your-web3forms-access-key-here
